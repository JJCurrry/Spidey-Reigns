#!/usr/bin/env sh
# 每次提交后自动刷新桌面离线 bundle，作为沙箱误删 .git 的兜底恢复源。
# 直接写绝对路径会踩 git bundle 的 .lock 怪癖，故先在仓库内生成再 mv。
#
# ⚠️ 环境坑：本沙箱（2026-08-31 会话）中 `git bundle create --all` 会挂起/极慢。
# 因此加三层防御：① timeout 限时 ② 后台化不阻塞 ③ 任何失败都不阻断提交。
# 若某环境确实连 timeout 都不可用，可临时 `mv` 本文件为 no-op，事后须还原。
TMP="./_git_backup_tmp.bundle"
DEST="/c/Users/Administrator/Desktop/Spidey-Reigns-gitbackup.bundle"

(
  if command -v timeout >/dev/null 2>&1; then
    timeout 60 git bundle create "$TMP" --all 2>/dev/null \
      && timeout 30 git bundle verify "$TMP" >/dev/null 2>&1 \
      && mv -f "$TMP" "$DEST" 2>/dev/null
  else
    git bundle create "$TMP" --all 2>/dev/null \
      && git bundle verify "$TMP" >/dev/null 2>&1 \
      && mv -f "$TMP" "$DEST" 2>/dev/null
  fi
  rm -f "$TMP" 2>/dev/null
) >/dev/null 2>&1 &

exit 0
